@tailwind base;
@tailwind components;
@tailwind utilities;

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

/* ==================================================
   1. DESIGN TOKENS
   ================================================== */
:root {
  /* Typography */
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  
  /* Backgrounds */
  --bg-dark-navy: #070914;
  --bg-dark-surface: rgba(20, 23, 48, 0.82);
  --bg-card: linear-gradient(145deg, rgba(38, 42, 76, 0.82), rgba(22, 25, 49, 0.92));
  --bg-input: rgba(8, 10, 24, 0.78);
  
  /* Borders */
  --border-subtle: rgba(255, 255, 255, 0.07);
  --border-input: rgba(255, 255, 255, 0.08);
  
  /* Accents */
  --color-violet: #8b5cf6;
  --color-pink: #ec4899;
  --color-blue: #3b82f6;
  
  /* Text */
  --text-primary: #ffffff;
  --text-secondary: #aaaac1;
  --text-muted: #7b7e99;
  
  /* Glows */
  --glow-violet: rgba(139, 92, 246, 0.3);
  --glow-pink: rgba(236, 72, 153, 0.3);
  
  /* Brand Gradients */
  --brand-gradient: linear-gradient(135deg, #6d3df5 0%, #a847f0 45%, #ec4899 100%);
}

/* ==================================================
   2. GLOBAL BACKGROUND & ATMOSPHERE
   ================================================== */
body {
  background: 
    radial-gradient(700px 500px at 5% 10%, rgba(124, 58, 237, 0.18), transparent 65%),
    radial-gradient(700px 500px at 95% 15%, rgba(236, 72, 153, 0.13), transparent 65%),
    radial-gradient(800px 600px at 55% 100%, rgba(79, 70, 229, 0.12), transparent 68%),
    linear-gradient(145deg, #070914 0%, #101329 50%, #090b19 100%) !important;
  background-attachment: fixed !important;
  color: var(--text-primary) !important;
  font-family: var(--font-sans) !important;
  margin: 0;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* Reset any background colors that block the body's dark navy */
#root > div {
  background: transparent !important;
}

/* Atmospheric lighting pseudo-elements */
body::before,
body::after {
  content: "";
  position: fixed;
  pointer-events: none;
  z-index: -1;
  border-radius: 50%;
  filter: blur(80px);
}

body::before {
  /* large violet blurred circle */
  top: 10%;
  left: 10%;
  width: 400px;
  height: 400px;
  background: rgba(124, 58, 237, 0.08);
}

body::after {
  /* large pink blurred circle */
  bottom: 10%;
  right: 10%;
  width: 500px;
  height: 500px;
  background: rgba(236, 72, 153, 0.06);
}

/* Very subtle grid overlay on the main container */
.min-h-screen::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: linear-gradient(rgba(139, 92, 246, 0.025) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(139, 92, 246, 0.025) 1px, transparent 1px);
  background-size: 42px 42px;
  z-index: -2;
  pointer-events: none;
}

/* ==================================================
   3. TYPOGRAPHY
   ================================================== */
h1, h2, h3, h4, h5, h6 {
  color: var(--text-primary) !important;
  font-weight: 700;
  letter-spacing: -0.02em;
}

p, span, label, td {
  color: var(--text-secondary);
}

/* ==================================================
   4. NAVBAR
   ================================================== */
nav {
  background: rgba(11, 14, 29, 0.6) !important;
  backdrop-filter: blur(16px) !important;
  border-bottom: 1px solid var(--border-subtle) !important;
  padding: 1rem 2.5rem !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
}

/* Nav Brand text */
nav a.text-xl, nav .font-bold {
  background: var(--brand-gradient) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  font-weight: 800 !important;
}

/* ==================================================
   5. ROUTE LINKS
   ================================================== */
nav a {
  color: var(--text-secondary) !important;
  font-weight: 500 !important;
  padding: 0.5rem 1rem !important;
  border-radius: 8px !important;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1) !important;
  position: relative;
  text-decoration: none !important;
  display: inline-block;
}

nav a:hover {
  color: var(--text-primary) !important;
  background: rgba(255, 255, 255, 0.05) !important;
}

/* Active links */
nav a.active, nav a[aria-current="page"] {
  color: var(--text-primary) !important;
  background: rgba(139, 92, 246, 0.10) !important;
}
nav a.active::after, nav a[aria-current="page"]::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 80%;
  height: 2px;
  background: linear-gradient(90deg, var(--color-violet), var(--color-pink));
  border-radius: 2px;
}

/* ==================================================
   6. DASHBOARD SHELL & CONTAINERS
   ================================================== */
/* Target the main inner wrapper */
.max-w-7xl.mx-auto {
  margin-top: 2rem !important;
  margin-bottom: 2rem !important;
  padding: 32px 48px !important;
  max-width: 1400px !important;
  background: transparent !important;
}

/* Remove harsh white from ANY remaining components */
.bg-white, .p-6.bg-white {
  background: var(--bg-dark-surface) !important;
  border: 1px solid var(--border-subtle) !important;
  backdrop-filter: blur(18px) !important;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.40) !important;
  border-radius: 18px !important;
}

/* ==================================================
   7. AGENT WORKLOAD & DASHBOARD SPECIFICS
   ================================================== */
/* Dashboard Heading */
.p-6.bg-white > h2, h2.border-b {
  font-weight: 700 !important;
  letter-spacing: -.03em !important;
  color: #f8f6ff !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
  position: relative;
  padding-bottom: 12px !important;
  margin-bottom: 24px !important;
}

.p-6.bg-white > h2::after, h2.border-b::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 45px;
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(90deg, #8b5cf6, #ec4899);
}

/* Agent Cards */
.grid.grid-cols-1.md\:grid-cols-2.lg\:grid-cols-3 > div,
.p-4.border.rounded.shadow-sm.flex.flex-col {
  background: var(--bg-card) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-radius: 15px !important;
  box-shadow: 10px 12px 30px rgba(0, 0, 0, 0.38), -4px -4px 15px rgba(60, 60, 100, 0.08) !important;
  backdrop-filter: blur(10px) !important;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease !important;
}

/* Hover for Agent Cards (Anti-gravity) */
.p-4.border.rounded.shadow-sm.flex.flex-col:hover {
  transform: translateY(-4px) !important;
  border-color: rgba(168, 85, 247, 0.35) !important;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.40), 0 0 25px rgba(139, 92, 246, 0.08) !important;
}

/* Agent Names & Details */
.font-bold.text-lg {
  color: #ffffff !important;
  letter-spacing: -0.01em !important;
}
.text-xs.text-gray-500 {
  color: #7c809f !important;
}

/* Agent Status Badges */
/* Online */
.bg-green-100.text-green-800 {
  background: rgba(16, 185, 129, 0.10) !important;
  border: 1px solid rgba(52, 211, 153, 0.22) !important;
  color: #62e0b5 !important;
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.1) !important;
  text-shadow: 0 0 8px rgba(16, 185, 129, 0.3) !important;
}
/* Offline */
.bg-red-100.text-red-800 {
  background: rgba(244, 63, 94, 0.10) !important;
  border: 1px solid rgba(244, 63, 94, 0.22) !important;
  color: #ff829e !important;
}

/* Workload Progress Bar */
/* Track */
.bg-gray-200.rounded-full.h-2\.5 {
  background: rgba(255, 255, 255, 0.08) !important;
  border-radius: 999px !important;
  height: 8px !important;
  overflow: hidden !important;
}
/* Fill */
.bg-gray-200.rounded-full.h-2\.5 > div {
  background: linear-gradient(90deg, #4f7cff, #8b5cf6, #d946ef) !important;
  height: 8px !important;
  border-radius: 999px !important;
  box-shadow: 0 0 12px rgba(139, 92, 246, 0.28) !important;
  transition: width 0.4s ease !important;
}

/* Load Capacity Text */
.text-sm.mb-1 > span:first-child {
  color: #aaaac1 !important;
}
.text-sm.mb-1 > span.font-semibold {
  color: #f4f1ff !important;
  font-weight: 700 !important;
}
.text-xs.mt-1.text-gray-500 {
  color: #8588a4 !important;
  font-weight: 600 !important;
}

/* Toggle Availability Button */
.mt-4.w-full.py-2.border.rounded {
  background: linear-gradient(145deg, rgba(52, 55, 90, 0.75), rgba(27, 30, 57, 0.85)) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  color: var(--text-primary) !important;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
}
.mt-4.w-full.py-2.border.rounded:hover {
  border-color: rgba(236, 72, 153, 0.4) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 8px 20px rgba(139, 92, 246, 0.2) !important;
  background: linear-gradient(145deg, rgba(62, 65, 100, 0.8), rgba(37, 40, 67, 0.9)) !important;
}
.mt-4.w-full.py-2.border.rounded:active {
  transform: translateY(1px) !important;
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3) !important;
}
.mt-4.w-full.py-2.border.rounded:focus-visible {
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.4) !important;
}

/* ==================================================
   8. TABLES
   ================================================== */
table {
  background: transparent !important;
  border-collapse: separate !important;
  border-spacing: 0 !important;
  width: 100% !important;
}

thead tr {
  background: rgba(0, 0, 0, 0.2) !important;
}

th {
  color: var(--text-primary) !important;
  font-size: 0.75rem !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  padding: 1rem !important;
  border-bottom: 1px solid var(--border-subtle) !important;
  font-weight: 600 !important;
}

td {
  padding: 1rem !important;
  color: var(--text-secondary) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03) !important;
  background: rgba(11, 14, 29, 0.4) !important;
  transition: background 0.2s ease !important;
}

tbody tr:hover td {
  background: rgba(139, 92, 246, 0.05) !important;
  color: var(--text-primary) !important;
}

/* ==================================================
   9. INPUTS / SEARCH / FILTERS
   ================================================== */
input, select, textarea {
  background: var(--bg-input) !important;
  border: 1px solid var(--border-input) !important;
  border-radius: 11px !important;
  color: var(--text-primary) !important;
  padding: 0.75rem 1rem !important;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2) !important;
  outline: none !important;
}

input:hover, select:hover, textarea:hover {
  border-color: rgba(255, 255, 255, 0.15) !important;
}

input:focus, select:focus, textarea:focus {
  border-color: var(--color-pink) !important;
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.12), 0 0 24px rgba(236, 72, 153, 0.08) !important;
}

input::placeholder, textarea::placeholder {
  color: var(--text-muted) !important;
}

/* ==================================================
   10. GLOBAL BUTTONS
   ================================================== */
button:not(.mt-4.w-full.py-2.border.rounded) {
  background: rgba(255, 255, 255, 0.05) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  color: var(--text-primary) !important;
  border-radius: 8px !important;
  padding: 0.6rem 1.2rem !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

button:not(.mt-4.w-full.py-2.border.rounded):hover {
  background: rgba(255, 255, 255, 0.1) !important;
  transform: translateY(-2px) !important;
  border-color: rgba(168, 85, 247, 0.3) !important;
  box-shadow: 0 4px 15px var(--glow-violet) !important;
}

button:not(.mt-4.w-full.py-2.border.rounded):active {
  transform: translateY(1px) !important;
  box-shadow: inset 0 2px 5px rgba(0,0,0,0.2) !important;
}

button:disabled {
  opacity: 0.5 !important;
  cursor: not-allowed !important;
  transform: none !important;
  box-shadow: none !important;
  border-color: transparent !important;
}

/* Primary CTA Buttons */
button.bg-blue-600, 
button.bg-gradient-to-r, 
button[type="submit"] {
  background: var(--brand-gradient) !important;
  border: none !important;
}

button.bg-blue-600:hover, 
button.bg-gradient-to-r:hover, 
button[type="submit"]:hover {
  background: linear-gradient(135deg, #7047f5 0%, #a847ef 50%, #ec4899 100%) !important;
  box-shadow: 0 10px 30px rgba(168, 85, 247, 0.24) !important;
  filter: brightness(1.1) !important;
}

/* ==================================================
   11. GENERAL STATUS BADGES
   ================================================== */
.bg-blue-900\/50, .text-blue-400 {
  background: rgba(59, 130, 246, 0.15) !important;
  color: #60a5fa !important;
  border: 1px solid rgba(59, 130, 246, 0.3) !important;
}

.bg-emerald-900\/50, .text-emerald-400 {
  background: rgba(16, 185, 129, 0.15) !important;
  color: #34d399 !important;
  border: 1px solid rgba(16, 185, 129, 0.3) !important;
}

.bg-rose-900\/50, .text-rose-400 {
  background: rgba(239, 68, 68, 0.15) !important;
  color: #f87171 !important;
  border: 1px solid rgba(239, 68, 68, 0.3) !important;
}

.bg-purple-900\/50, .text-purple-400 {
  background: rgba(139, 92, 246, 0.15) !important;
  color: #a78bfa !important;
  border: 1px solid rgba(139, 92, 246, 0.3) !important;
}

.bg-amber-900\/50, .text-amber-400 {
  background: rgba(245, 158, 11, 0.15) !important;
  color: #fbbf24 !important;
  border: 1px solid rgba(245, 158, 11, 0.3) !important;
}

/* ============================================================
   LOGIN PAGE — CINEMATIC UI BACKGROUND
   ============================================================ */

/* 1. Login background & 2. Background overlays */
.min-h-screen.flex.items-center.justify-center {
  background-image: 
    linear-gradient(135deg, rgba(6, 8, 20, 0.72), rgba(24, 13, 48, 0.48), rgba(9, 10, 25, 0.76)),
    url('/uibackground.png') !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  background-color: var(--bg-dark-navy) !important;
  position: relative !important;
  z-index: 1;
  overflow: hidden;
}

/* 3. Atmospheric effects (vignette and glow) */
.min-h-screen.flex.items-center.justify-center::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  /* Vignette & glows */
  background: 
    radial-gradient(ellipse at center, transparent 20%, rgba(4, 5, 15, 0.52) 100%),
    radial-gradient(700px circle at 15% 20%, rgba(139, 92, 246, 0.15), transparent 60%),
    radial-gradient(700px circle at 85% 80%, rgba(236, 72, 153, 0.1), transparent 60%);
  z-index: -1;
  pointer-events: none;
}

/* 4. Login card & 7. Login form */
.min-h-screen.flex.items-center.justify-center form {
  background: rgba(14, 17, 37, 0.63) !important;
  backdrop-filter: blur(22px) saturate(130%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(130%) !important;
  border: 1px solid rgba(255, 255, 255, 0.18) !important;
  border-radius: 24px !important;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55), 0 0 35px rgba(139, 92, 246, 0.10), 0 0 55px rgba(236, 72, 153, 0.07) !important;
  padding: 3.5rem !important;
  width: 100% !important;
  max-width: 480px !important;
  position: relative;
  transition: transform 0.3s ease !important;
}

/* 23. Anti-gravity glass hover */
.min-h-screen.flex.items-center.justify-center form:hover {
  transform: translateY(-2px) !important;
}

/* 13. Login title */
.min-h-screen.flex.items-center.justify-center form h2 {
  color: #ffffff !important;
  font-weight: 700 !important;
  letter-spacing: -.03em !important;
  font-size: 2.25rem !important;
  margin-bottom: 2rem !important;
  text-align: center !important;
  background: none !important;
  -webkit-text-fill-color: #ffffff !important;
  position: relative;
  padding-bottom: 12px !important;
}

.min-h-screen.flex.items-center.justify-center form h2::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(90deg, #8b5cf6, #ec4899);
}

/* 8. Inputs */
.min-h-screen.flex.items-center.justify-center form input {
  background: rgba(7, 9, 22, 0.62) !important;
  border: 1px solid rgba(255, 255, 255, 0.11) !important;
  color: #ffffff !important;
  border-radius: 10px !important;
  box-shadow: inset 2px 3px 8px rgba(0, 0, 0, 0.25) !important;
  padding: 1rem !important;
  transition: all 0.22s ease !important;
}

/* 15. Input focus response */
.min-h-screen.flex.items-center.justify-center form input:hover {
  border-color: rgba(255, 255, 255, 0.25) !important;
}

.min-h-screen.flex.items-center.justify-center form input:focus,
.min-h-screen.flex.items-center.justify-center form input:focus-visible {
  border-color: rgba(168, 85, 247, 0.75) !important;
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.12), 0 0 25px rgba(236, 72, 153, 0.08), inset 2px 3px 8px rgba(0, 0, 0, 0.25) !important;
  outline: none !important;
}

.min-h-screen.flex.items-center.justify-center form label {
  color: var(--text-secondary) !important;
  font-size: 0.85rem !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  margin-bottom: 0.5rem !important;
}

/* 16. Login Button */
.min-h-screen.flex.items-center.justify-center form button[type="submit"] {
  background: linear-gradient(135deg, #7047f5 0%, #a847ef 50%, #ec4899 100%) !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 11px !important;
  box-shadow: 0 12px 28px rgba(139, 92, 246, 0.28) !important;
  margin-top: 1.5rem !important;
  padding: 1.1rem !important;
  font-size: 1.05rem !important;
  letter-spacing: 0.05em !important;
  width: 100% !important;
  transition: all 0.25s ease !important;
}

/* 17. Button hover */
.min-h-screen.flex.items-center.justify-center form button[type="submit"]:hover {
  background: linear-gradient(135deg, #7c3aed 0%, #c026d3 50%, #db2777 100%) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 15px 35px rgba(139, 92, 246, 0.4) !important;
  filter: brightness(1.1) !important;
}

/* 18. Button active */
.min-h-screen.flex.items-center.justify-center form button[type="submit"]:active {
  transform: translateY(1px) !important;
  box-shadow: inset 0 3px 6px rgba(0,0,0,0.3) !important;
}

/* 19. Button focus */
.min-h-screen.flex.items-center.justify-center form button[type="submit"]:focus-visible {
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.6) !important;
}

/* 20. Button disabled */
.min-h-screen.flex.items-center.justify-center form button[type="submit"]:disabled {
  background: rgba(40, 42, 60, 0.8) !important;
  box-shadow: none !important;
  opacity: 0.6 !important;
  cursor: not-allowed !important;
  transform: none !important;
}

/* 21. Register / Forgot Password Links */
.min-h-screen.flex.items-center.justify-center form button[type="button"] {
  background: transparent !important;
  border: none !important;
  color: #c1b7dd !important;
  box-shadow: none !important;
  padding: 0.5rem !important;
  transition: color 0.25s ease !important;
  font-weight: 500 !important;
}

.min-h-screen.flex.items-center.justify-center form button[type="button"]:hover {
  color: #f08bc5 !important;
  text-decoration: underline !important;
  transform: none !important;
}

/* 22. Checkbox */
.min-h-screen.flex.items-center.justify-center form input[type="checkbox"] {
  accent-color: #a855f7 !important;
}

/* ==================================================
   RESPONSIVE STYLES
   ================================================== */
@media (max-width: 1024px) {
  .max-w-7xl.mx-auto {
    max-width: 96% !important;
    padding: 1.5rem !important;
  }
}

@media (max-width: 768px) {
  .max-w-7xl.mx-auto {
    padding: 1rem !important;
    margin-top: 1rem !important;
    border-radius: 14px !important;
  }
  
  nav {
    flex-direction: column !important;
    padding: 1rem !important;
  }
  
  nav div {
    margin-top: 1rem !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 0.5rem !important;
  }
  
  nav a {
    font-size: 0.9rem !important;
    padding: 0.5rem !important;
  }
}

@media (max-width: 480px) {
  .min-h-screen.flex.items-center.justify-center form {
    padding: 2rem !important;
    border-radius: 20px !important;
  }
}

/* ==================================================
   ACCESSIBILITY / REDUCED MOTION
   ================================================== */
*:focus-visible {
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.5) !important;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
    transform: none !important;
  }
}
